# ─── LLM Provider Configuration ───────────────────────────────────────────────
# Supported providers: openai, anthropic, google, azure_openai
MODEL_PROVIDER=

# The model name to use (e.g. gpt-4o, claude-3-5-sonnet, gemini-1.5-pro)
MODEL_NAME=

# API key for the chosen provider — NEVER commit a real key
API_KEY=

# ─── Azure OpenAI (only required when MODEL_PROVIDER=azure_openai) ─────────────
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=

# ─── Application Settings ──────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Directory where run output artefacts are written
OUTPUT_DIR=output

# Maximum number of times the Orchestrator will retry a failed agent step
MAX_AGENT_RETRIES=3
